.DS_Store
node_modules

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.idea
.vscode
.claude
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# vitepress build output & temp files
dist/
/*.md
!AGENTS.md

.vitepress/cache/
.vitepress/.temp/

# 本機文章草稿；只提交目錄說明與範本
drafts/*
!drafts/README.md
!drafts/_template.md

# 建置期產生的 WebP 衍生圖（由 imageOptimizer.js 生成）
public/**/*.opt.webp

# 文章圖片的來源在 posts/<slug>/，這裡只放建置期產生的可部署版本
public/generated/posts/
